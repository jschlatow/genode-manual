source "../foundations/cover.gosh"

proc subtitle {} { return "Applications" }

proc title {} { return "Sculpt Operating System" }

proc titleshort {} { return "Sculpt OS" }

proc version {} { return "25.04" }

proc author {} { return "Johannes Schlatow" }

proc titlecolor  {} { return {\definecolor{titlecolor}   {rgb}{0.878,0.577,0.567}}}
proc titlecol    {} { return {\definecolor{titlecol}     {rgb}{1,1,1}}}
proc subtitlecol {} { return {\definecolor{subtitlecol}  {rgb}{0.95,0.85,0.5}}}

proc spinewidth  {} { return "10.2mm" }
proc bleedwidth  {} { return "2mm" }
